{
  "name": "fontcatch",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "tauri": "node scripts/native.mjs tauri",
    "desktop": "node scripts/native.mjs tauri dev",
    "desktop:build": "node scripts/native.mjs tauri build",
    "test": "vitest run",
    "test:rust": "node scripts/native.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/icons.mjs && tauri icon src/assets/brand/app-icon.png",
    "test:ui": "playwright test",
    "format": "prettier --write src scripts tests *.json *.ts index.html",
    "format:rust": "node scripts/native.mjs cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test:tooling": "node --test scripts/native.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "description": "Catch your next typeface. A local desktop font installer."
}
